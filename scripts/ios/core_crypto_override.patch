+private fun sha1(message: ByteArray): ByteArray {
+    val paddedLength = ((message.size + 9 + 63) / 64) * 64
+    val padded = ByteArray(paddedLength)
+    message.copyInto(padded)
+    padded[message.size] = 0x80.toByte()
+    val bitLength = message.size.toLong() * 8L
+    for (index in 0 until 8) padded[paddedLength - 1 - index] = (bitLength ushr (index * 8)).toByte()
+
