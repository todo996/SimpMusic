+private fun hmacSha256(
+    key: ByteArray,
+    data: ByteArray,
+): ByteArray {
+    val blockSize = 64
+    val normalizedKey = if (key.size > blockSize) sha256(key) else key
+    val paddedKey = ByteArray(blockSize)
+    normalizedKey.copyInto(paddedKey)
+
+    val inner = ByteArray(blockSize + data.size)
+    for (index in 0 until blockSize) inner[index] = (paddedKey[index].toInt() xor 0x36).toByte()
+    data.copyInto(inner, blockSize)
+    val innerHash = sha256(inner)
+
+    val outer = ByteArray(blockSize + innerHash.size)
+    for (index in 0 until blockSize) outer[index] = (paddedKey[index].toInt() xor 0x5c).toByte()
+    innerHash.copyInto(outer, blockSize)
+    return sha256(outer)
+}
