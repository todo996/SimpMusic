+    val bitLength = message.size.toLong() * 8L
+    for (index in 0 until 8) padded[paddedLength - 1 - index] = (bitLength ushr (index * 8)).toByte()
+
+    val state = intArrayOf(
+        0x6a09e667.toInt(), 0xbb67ae85.toInt(), 0x3c6ef372.toInt(), 0xa54ff53a.toInt(),
+        0x510e527f.toInt(), 0x9b05688c.toInt(), 0x1f83d9ab.toInt(), 0x5be0cd19.toInt(),
+    )
+    val schedule = IntArray(64)
+    for (offset in padded.indices step 64) {
+        for (index in 0 until 16) {
+            val start = offset + index * 4
+            schedule[index] =
+                ((padded[start].toInt() and 0xff) shl 24) or
+                    ((padded[start + 1].toInt() and 0xff) shl 16) or
+                    ((padded[start + 2].toInt() and 0xff) shl 8) or
