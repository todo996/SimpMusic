+
+private const val BASE32_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
+
+private fun decodeBase32(value: String): ByteArray {
+    var buffer = 0
+    var bits = 0
+    val result = ArrayList<Byte>()
+    value.filterNot { it == '=' || it.isWhitespace() }.forEach { character ->
+        val digit = BASE32_ALPHABET.indexOf(character.uppercaseChar())
+        require(digit >= 0) { "Invalid Spotify TOTP secret" }
+        buffer = (buffer shl 5) or digit
+        bits += 5
+        if (bits >= 8) {
+            bits -= 8
+            result += ((buffer shr bits) and 0xff).toByte()
+        }
+    }
+    return result.toByteArray()
+}
