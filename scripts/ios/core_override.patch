+package com.maxrave.data.mediaservice
+
+import com.maxrave.common.Config
+import com.maxrave.domain.data.entities.NewFormatEntity
+import com.maxrave.domain.data.entities.SongEntity
+import com.maxrave.domain.data.model.browse.album.Track
+import com.maxrave.domain.data.model.mediaService.SponsorSkipSegments
+import com.maxrave.domain.data.player.GenericCastState
+import com.maxrave.domain.data.player.GenericCommandButton
+import com.maxrave.domain.data.player.GenericMediaItem
+import com.maxrave.domain.data.player.PlayerConstants
+import com.maxrave.domain.data.player.PlayerError
+import com.maxrave.domain.extension.toGenericMediaItem
+import com.maxrave.domain.extension.toSongEntity
+import com.maxrave.domain.mediaservice.handler.ControlState
+import com.maxrave.domain.mediaservice.handler.MediaPlayerHandler
+import com.maxrave.domain.mediaservice.handler.NowPlayingTrackState
+import com.maxrave.domain.mediaservice.handler.PlayerEvent
+import com.maxrave.domain.mediaservice.handler.PlaylistType
+import com.maxrave.domain.mediaservice.handler.QueueData
+import com.maxrave.domain.mediaservice.handler.RepeatState
+import com.maxrave.domain.mediaservice.handler.SimpleMediaState
+import com.maxrave.domain.mediaservice.handler.SleepTimerState
+import com.maxrave.domain.mediaservice.handler.ToastType
+import com.maxrave.domain.manager.DataStoreManager
+import com.maxrave.domain.mediaservice.player.MediaPlayerInterface
+import com.maxrave.domain.mediaservice.player.MediaPlayerListener
+import com.maxrave.domain.repository.AnalyticsRepository
+import com.maxrave.domain.repository.LocalPlaylistRepository
+import com.maxrave.domain.repository.SongRepository
+import com.maxrave.domain.repository.StreamRepository
+import com.maxrave.domain.utils.Resource
+import com.maxrave.domain.utils.toSongEntity
+import com.maxrave.domain.utils.toTrack
+import com.maxrave.logger.Logger
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.firstOrNull
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import org.koin.mp.KoinPlatform.getKoin
+
+private const val TAG = "IosMediaPlayerHandler"
+
+/**
+ * iOS counterpart of the Android/JVM service handler.
+ *
+ * It intentionally keeps the same domain contract and queue semantics, while leaving Android
+ * notification/session concerns out of the iOS binary. The AVPlayer adapter remains the only
+ * platform-specific playback dependency.
+ */
+class IosMediaPlayerHandler(
+    private val dataStoreManager: DataStoreManager,
+    private val songRepository: SongRepository,
+    private val streamRepository: StreamRepository,
+    @Suppress("UNUSED_PARAMETER") private val localPlaylistRepository: LocalPlaylistRepository,
+    @Suppress("UNUSED_PARAMETER") private val analyticsRepository: AnalyticsRepository,
+    private val coroutineScope: CoroutineScope,
+) : MediaPlayerHandler,
+    MediaPlayerListener {
+    override val player: MediaPlayerInterface = getKoin().get()
+
+    override var onUpdateNotification: (List<GenericCommandButton>) -> Unit = {}
+    override var pushPlayerError: (PlayerError) -> Unit = {}
+    override var showToast: (ToastType) -> Unit = {}
+
+    private val _simpleMediaState = MutableStateFlow<SimpleMediaState>(SimpleMediaState.Initial)
+    override val simpleMediaState: StateFlow<SimpleMediaState> = _simpleMediaState.asStateFlow()
+
+    private val _nowPlaying = MutableStateFlow<GenericMediaItem?>(player.currentMediaItem)
+    override val nowPlaying: StateFlow<GenericMediaItem?> = _nowPlaying.asStateFlow()
+
+    private val _queueData = MutableStateFlow(QueueData())
+    override val queueData: StateFlow<QueueData?> = _queueData.asStateFlow()
+
+    private val _controlState =
+        MutableStateFlow(
+            ControlState(
+                isPlaying = player.isPlaying,
+                isShuffle = player.shuffleModeEnabled,
+                repeatState = repeatState(player.repeatMode),
+                isLiked = false,
+                isNextAvailable = player.hasNextMediaItem(),
+                isPreviousAvailable = player.hasPreviousMediaItem(),
+                isCrossfading = false,
+                volume = player.volume,
+            ),
+        )
+    override val controlState: StateFlow<ControlState> = _controlState.asStateFlow()
+
+    private val _nowPlayingState = MutableStateFlow(NowPlayingTrackState.initial())
+    override val nowPlayingState: StateFlow<NowPlayingTrackState> = _nowPlayingState.asStateFlow()
+
+    private val _sleepTimerState = MutableStateFlow(SleepTimerState(false, 0))
+    override val sleepTimerState: StateFlow<SleepTimerState> = _sleepTimerState.asStateFlow()
+
+    private val _skipSegments = MutableStateFlow<List<SponsorSkipSegments>?>(null)
+    override val skipSegments: StateFlow<List<SponsorSkipSegments>?> = _skipSegments.asStateFlow()
+
+    private val _format = MutableStateFlow<NewFormatEntity?>(null)
+    override val format: StateFlow<NewFormatEntity?> = _format.asStateFlow()
+
+    private val _currentSongIndex = MutableStateFlow(player.currentMediaItemIndex)
+    override val currentSongIndex: StateFlow<Int> = _currentSongIndex.asStateFlow()
+
+    override val castState: StateFlow<GenericCastState> =
+        MutableStateFlow(GenericCastState.NOT_CASTING).asStateFlow()
+
+    private var sleepTimerJob: Job? = null
+    private var relatedJob: Job? = null
+    private var released = false
+
+    init {
+        player.addListener(this)
+        coroutineScope.launch {
+            attempt { dataStoreManager.playerVolume.first() }.getOrNull()?.let { player.volume = it }
+        }
+        coroutineScope.launch {
+            attempt { mayBeRestoreQueue() }
+        }
+    }
+
+    override suspend fun onPlayerEvent(playerEvent: PlayerEvent) {
+        when (playerEvent) {
+            PlayerEvent.PlayPause -> if (player.isPlaying) player.pause() else player.play()
+            PlayerEvent.Backward -> player.seekBack()
+            PlayerEvent.Forward -> player.seekForward()
+            PlayerEvent.Stop -> {
+                player.stop()
+                _nowPlayingState.value = NowPlayingTrackState.initial()
+            }
+            PlayerEvent.Next -> player.seekToNext()
+            PlayerEvent.Previous -> player.seekToPrevious()
+            PlayerEvent.SkipToPrevious -> player.seekToPreviousMediaItem()
+            PlayerEvent.Shuffle -> player.shuffleModeEnabled = !player.shuffleModeEnabled
+            PlayerEvent.Repeat -> {
+                player.repeatMode =
+                    when (player.repeatMode) {
+                        PlayerConstants.REPEAT_MODE_OFF -> PlayerConstants.REPEAT_MODE_ALL
+                        PlayerConstants.REPEAT_MODE_ALL -> PlayerConstants.REPEAT_MODE_ONE
+                        else -> PlayerConstants.REPEAT_MODE_OFF
+                    }
+            }
+            is PlayerEvent.UpdateProgress ->
+                player.seekTo((player.duration * playerEvent.newProgress / 100f).toLong())
+            PlayerEvent.ToggleLike -> toggleLike()
+            is PlayerEvent.UpdateVolume -> player.volume = playerEvent.newVolume
+        }
+    }
+
+    override fun toggleRadio() {
+        nowPlayingState.value.mediaItem.mediaId.takeIf { it.isNotBlank() }?.let(::getRelated)
+    }
+
+    override fun toggleLike() {
+        val mediaId = player.currentMediaItem?.mediaId ?: return
+        coroutineScope.launch {
+            val liked = controlState.value.isLiked
+            attempt { songRepository.updateLikeStatus(mediaId, if (liked) 0 else 1) }
+            _controlState.update { it.copy(isLiked = !liked) }
+        }
+    }
+
+    override fun like(liked: Boolean) {
+        _controlState.update { it.copy(isLiked = liked) }
+    }
+
+    override fun resetSongAndQueue() {
+        clearMediaItems()
+        _queueData.value = QueueData()
+        _nowPlayingState.value = NowPlayingTrackState.initial()
+    }
+
+    override fun sleepStart(minutes: Int) {
+        sleepTimerJob?.cancel()
+        sleepTimerJob = coroutineScope.launch {
+            val waitMs =
+                if (minutes == Int.MAX_VALUE) {
+                    (player.duration - player.currentPosition).coerceAtLeast(0L)
+                } else {
+                    minutes.coerceAtLeast(0).toLong() * 60_000L
+                }
+            _sleepTimerState.value = SleepTimerState(false, (waitMs / 60_000L).toInt())
+            var remaining = waitMs
+            while (remaining > 0L) {
+                delay(minOf(remaining, 1_000L))
+                remaining -= 1_000L
+                _sleepTimerState.value = SleepTimerState(false, (remaining / 60_000L).toInt())
+            }
+            player.sleepFadeFactor = 0f
+            player.pause()
+            player.sleepFadeFactor = 1f
+            _sleepTimerState.value = SleepTimerState(true, 0)
+        }
+    }
+
+    override fun sleepStop() {
+        sleepTimerJob?.cancel()
+        sleepTimerJob = null
+        player.sleepFadeFactor = 1f
+        _sleepTimerState.value = SleepTimerState(false, 0)
+    }
+
+    override fun removeMediaItem(position: Int) {
+        player.removeMediaItem(position)
+        updateQueueTracks { tracks -> tracks.filterIndexed { index, _ -> index != position } }
+    }
+
+    override fun addMediaItem(
+        mediaItem: GenericMediaItem,
+        playWhenReady: Boolean,
+    ) {
+        if (player.mediaItemCount == 0) player.setMediaItem(mediaItem) else player.addMediaItem(mediaItem)
+        player.prepare()
+        player.playWhenReady = playWhenReady
+        _nowPlaying.value = player.currentMediaItem ?: mediaItem
+        updateControlAvailability()
+    }
+
+    override fun clearMediaItems() {
+        player.clearMediaItems()
+        _nowPlaying.value = null
+        _nowPlayingState.value = NowPlayingTrackState.initial()
+        updateControlAvailability()
+    }
+
+    override fun addMediaItemList(mediaItemList: List<GenericMediaItem>) {
+        mediaItemList.forEach { mediaItem ->
+            if (player.getCurrentMediaTimeLine().none { it.mediaId == mediaItem.mediaId }) player.addMediaItem(mediaItem)
+        }
+        player.prepare()
+        updateControlAvailability()
+    }
+
+    override fun playMediaItemInMediaSource(index: Int) {
+        val actualIndex = if (player.shuffleModeEnabled) player.getUnshuffledIndex(index) else index
+        if (actualIndex !in 0 until player.mediaItemCount) return
+        player.seekTo(actualIndex, 0L)
+        player.playWhenReady = true
+    }
+
+    override fun currentSongIndex(): Int = player.currentMediaItemIndex
+
+    override fun currentOrderIndex(): Int {
+        val mediaId = player.currentMediaItem?.mediaId ?: return player.currentMediaItemIndex
+        return _queueData.value.data.listTracks.indexOfFirst { it.videoId == mediaId }
+            .takeIf { it >= 0 } ?: player.currentMediaItemIndex
+    }
+
+    override suspend fun swap(
+        from: Int,
+        to: Int,
+    ) {
+        if (from !in 0 until player.mediaItemCount || to !in 0 until player.mediaItemCount) return
+        player.moveMediaItem(from, to)
+        updateQueueTracks { tracks ->
+            tracks.toMutableList().also {
+                if (from in it.indices && to in it.indices) it.add(to, it.removeAt(from))
+            }
+        }
+    }
+
+    override fun resetCrossfade() {
+        _controlState.update { it.copy(isCrossfading = false) }
+    }
+
+    override fun shufflePlaylist(randomTrackIndex: Int) {
+        if (player.mediaItemCount == 0) return
+        player.shuffleModeEnabled = true
+        if (randomTrackIndex in 0 until player.mediaItemCount) playMediaItemInMediaSource(randomTrackIndex)
+    }
+
+    override fun loadMore() {
+        // Continuations are owned by the YouTube repository. iOS keeps the already loaded queue
+        // playable and does not turn an unavailable continuation into a crash.
+        if (_queueData.value.data.continuation == null) return
+    }
+
+    override fun getRelated(videoId: String) {
+        relatedJob?.cancel()
+        relatedJob = coroutineScope.launch {
+            attempt {
+                songRepository.getRelatedData(videoId).collect { resource ->
+                    if (resource is Resource.Success) {
+                        resource.data?.first?.let { loadMoreCatalog(ArrayList(it), isAddToQueue = true) }
+                        _queueData.update { it.setContinuation(resource.data?.second ?: "") }
+                    }
+                }
+            }.onFailure { Logger.w(TAG, "Related tracks unavailable: ${it.message}") }
+        }
+    }
+
+    override fun setQueueData(queueData: QueueData.Data) {
+        _queueData.value = QueueData(QueueData.StateSource.STATE_INITIALIZED, queueData)
+        player.albumTrackIds =
+            if (queueData.playlistType == PlaylistType.ALBUM) queueData.listTracks.map { it.videoId }.toSet() else emptySet()
+        updateControlAvailability()
+    }
+
+    override fun getCurrentMediaItem(): GenericMediaItem? = player.currentMediaItem
+
+    override suspend fun moveItemUp(position: Int) {
+        if (position > 0) swap(position, position - 1)
+    }
+
+    override suspend fun moveItemDown(position: Int) {
+        if (position < player.mediaItemCount - 1) swap(position, position + 1)
+    }
+
+    override fun addFirstMediaItemToIndex(
+        mediaItem: GenericMediaItem?,
+        index: Int,
+    ) {
+        mediaItem ?: return
+        player.addMediaItem(index.coerceIn(0, player.mediaItemCount), mediaItem)
+        updateControlAvailability()
+    }
+
+    override fun reset() {
+        clearMediaItems()
+        _queueData.value = QueueData()
+    }
+
+    override suspend fun load(
+        downloaded: Int,
+        index: Int?,
+    ) {
+        val tracks = _queueData.value.data.listTracks
+        if (tracks.isEmpty()) return
+        if (player.mediaItemCount == 0) addMediaItemList(tracks.map { it.toGenericMediaItem() })
+        index?.let { playMediaItemInMediaSource(it) }
+    }
+
+    override suspend fun loadMoreCatalog(
+        listTrack: ArrayList<Track>,
+        isAddToQueue: Boolean,
+    ) {
+        val existing = _queueData.value.data.listTracks.map { it.videoId }.toSet()
+        val fresh = listTrack.filter { it.videoId !in existing }
+        if (fresh.isEmpty()) return
+        _queueData.update {
+            it.copy(
+                queueState = QueueData.StateSource.STATE_INITIALIZED,
+                data = it.data.copy(listTracks = it.data.listTracks + fresh),
+            )
+        }
+        if (isAddToQueue || player.mediaItemCount > 0) addMediaItemList(fresh.map { it.toGenericMediaItem() })
+    }
+
+    override suspend fun updateCatalog(
+        downloaded: Int,
+        index: Int?,
+    ): Boolean {
+        load(downloaded, index)
+        return true
+    }
+
+    override fun addQueueToPlayer() {
+        coroutineScope.launch { load() }
+    }
+
+    override fun loadPlaylistOrAlbum(index: Int?) {
+        coroutineScope.launch {
+            val tracks = _queueData.value.data.listTracks
+            val existing = player.getCurrentMediaTimeLine().map { it.mediaId }.toSet()
+            val remaining = tracks.filter { it.videoId !in existing }
+            if (remaining.isNotEmpty()) addMediaItemList(remaining.map { it.toGenericMediaItem() })
+            index?.let { playMediaItemInMediaSource(it) }
+        }
+    }
+
+    override fun setCurrentSongIndex(index: Int) {
+        if (index in 0 until player.mediaItemCount) playMediaItemInMediaSource(index)
+    }
+
+    override suspend fun playNext(track: Track) {
+        val mediaItem = track.toGenericMediaItem()
+        val insertAt = (player.currentMediaItemIndex + 1).coerceAtLeast(0).coerceAtMost(player.mediaItemCount)
+        player.addMediaItem(insertAt, mediaItem)
+        updateQueueTracks { tracks -> tracks.toMutableList().also { it.add(insertAt.coerceAtMost(it.size), track) } }
+        updateControlAvailability()
+    }
+
+    override suspend fun <T> loadMediaItem(
+        anyTrack: T,
+        type: String,
+        index: Int?,
+    ) {
+        val track =
+            when (anyTrack) {
+                is Track -> anyTrack
+                is SongEntity -> anyTrack.toTrack()
+                else -> return
+            }
+        if (track.isExplicit && attempt { dataStoreManager.explicitContentEnabled.first() }.getOrNull() != DataStoreManager.TRUE) {
+            showToast(ToastType.ExplicitContent)
+            return
+        }
+        attempt { songRepository.insertSong(track.toSongEntity()).firstOrNull() }
+        track.durationSeconds?.let { attempt { songRepository.updateDurationSeconds(it, track.videoId) } }
+        clearMediaItems()
+        addMediaItem(track.toGenericMediaItem(), playWhenReady = type != Config.RECOVER_TRACK_QUEUE)
+        when (type) {
+            Config.SONG_CLICK, Config.VIDEO_CLICK, Config.SHARE -> getRelated(track.videoId)
+            Config.PLAYLIST_CLICK, Config.ALBUM_CLICK, Config.RADIO_CLICK -> loadPlaylistOrAlbum(index)
+        }
+    }
+
+    override fun getPlayerDuration(): Long = player.duration
+
+    override fun getProgress(): Long = player.currentPosition
+
+    override fun startProgressUpdate() = Unit
+
+    override fun stopProgressUpdate() = Unit
+
+    override fun startBufferedUpdate() = Unit
+
+    override fun stopBufferedUpdate() = Unit
+
+    override fun mayBeNormalizeVolume() = Unit
+
+    override fun mayBeSaveRecentSong(runBlocking: Boolean) {
+        val mediaId = player.currentMediaItem?.mediaId ?: return
+        coroutineScope.launch {
+            attempt {
+                if (dataStoreManager.saveRecentSongAndQueue.first() == DataStoreManager.TRUE) {
+                    dataStoreManager.saveRecentSong(mediaId, player.contentPosition)
+                    dataStoreManager.setPlaylistFromSaved(_queueData.value.data.playlistName ?: "")
+                    songRepository.recoverQueue(_queueData.value.data.listTracks)
+                }
+            }
+        }
+    }
+
+    override fun mayBeSavePlaybackState() {
+        coroutineScope.launch {
+            attempt {
+                dataStoreManager.recoverShuffleAndRepeatKey(player.shuffleModeEnabled, player.repeatMode)
+            }
+        }
+    }
+
+    override fun mayBeRestoreQueue() {
+        coroutineScope.launch {
+            attempt {
+                if (dataStoreManager.saveRecentSongAndQueue.first() != DataStoreManager.TRUE) return@attempt
+                val mediaId = dataStoreManager.recentMediaId.first().takeIf { it.isNotBlank() } ?: return@attempt
+                val saved = songRepository.getSongById(mediaId).firstOrNull()?.toTrack() ?: return@attempt
+                setQueueData(QueueData.Data(listTracks = listOf(saved), firstPlayedTrack = saved, playlistType = PlaylistType.RADIO))
+                addMediaItem(saved.toGenericMediaItem(), playWhenReady = false)
+                val position = dataStoreManager.recentPosition.first().toLongOrNull() ?: 0L
+                if (position > 0L) player.seekTo(position)
+            }
+        }
+    }
+
+    override fun shouldReleaseOnTaskRemoved(): Boolean = false
+
+    override fun release() {
+        if (released) return
+        released = true
+        sleepTimerJob?.cancel()
+        relatedJob?.cancel()
+        player.removeListener(this)
+        player.release()
+    }
+
+    override fun onPlaybackStateChanged(playbackState: Int) {
+        _simpleMediaState.value =
+            when (playbackState) {
+                PlayerConstants.STATE_READY -> SimpleMediaState.Ready(player.duration)
+                PlayerConstants.STATE_BUFFERING -> SimpleMediaState.Buffering(player.currentPosition)
+                PlayerConstants.STATE_ENDED -> SimpleMediaState.Ended
+                else -> SimpleMediaState.Initial
+            }
+    }
+
+    override fun onIsPlayingChanged(isPlaying: Boolean) {
+        _controlState.update { it.copy(isPlaying = isPlaying) }
+        updateControlAvailability()
+    }
+
+    override fun onMediaItemTransition(
+        mediaItem: GenericMediaItem?,
+        reason: Int,
+    ) {
+        _nowPlaying.value = mediaItem
+        _currentSongIndex.value = player.currentMediaItemIndex
+        if (mediaItem == null) {
+            _nowPlayingState.value = NowPlayingTrackState.initial()
+            return
+        }
+        coroutineScope.launch {
+            val track = _queueData.value.data.listTracks.firstOrNull { it.videoId == mediaItem.mediaId }
+            val entity =
+                track?.toSongEntity()
+                    ?: attempt { songRepository.getSongById(mediaItem.mediaId).firstOrNull() }.getOrNull()
+                    ?: mediaItem.toSongEntity()
+            if (track != null) attempt { songRepository.insertSong(entity).firstOrNull() }
+            _nowPlayingState.value = NowPlayingTrackState(mediaItem, track, entity)
+            attempt { _format.value = streamRepository.getNewFormat(mediaItem.mediaId).firstOrNull() }
+            attempt {
+                _controlState.update { it.copy(isLiked = songRepository.getLikeStatus(mediaItem.mediaId).first()) }
+            }
+        }
+    }
+
+    override fun onTimelineChanged(
+        list: List<GenericMediaItem>,
+        reason: String,
+    ) {
+        _currentSongIndex.value = player.currentMediaItemIndex
+        updateControlAvailability()
+    }
+
+    override fun onPlayerError(error: PlayerError) {
+        pushPlayerError(error)
+        showToast(ToastType.PlayerError(error.message ?: error.errorCodeName))
+    }
+
+    override fun onShuffleModeEnabledChanged(
+        shuffleModeEnabled: Boolean,
+        list: List<GenericMediaItem>,
+    ) {
+        _controlState.update { it.copy(isShuffle = shuffleModeEnabled) }
+    }
+
+    override fun onRepeatModeChanged(repeatMode: Int) {
+        _controlState.update { it.copy(repeatState = repeatState(repeatMode)) }
+    }
+
+    override fun onVolumeChanged(volume: Float) {
+        _controlState.update { it.copy(volume = volume) }
+    }
+
+    private fun updateControlAvailability() {
+        _controlState.update {
+            it.copy(
+                isPlaying = player.isPlaying,
+                isNextAvailable = player.hasNextMediaItem(),
+                isPreviousAvailable = player.hasPreviousMediaItem(),
+                isShuffle = player.shuffleModeEnabled,
+                repeatState = repeatState(player.repeatMode),
+                volume = player.volume,
+            )
+        }
+    }
+
+    private fun updateQueueTracks(transform: (List<Track>) -> List<Track>) {
+        _queueData.update { queue -> queue.copy(data = queue.data.copy(listTracks = transform(queue.data.listTracks))) }
+    }
+
+    private fun repeatState(mode: Int): RepeatState =
+        when (mode) {
+            PlayerConstants.REPEAT_MODE_ONE -> RepeatState.One
+            PlayerConstants.REPEAT_MODE_ALL -> RepeatState.All
+            else -> RepeatState.None
+        }
+
+    private suspend fun <T> attempt(block: suspend () -> T): Result<T> =
+        try {
+            Result.success(block())
+        } catch (error: Throwable) {
+            Result.failure(error)
+        }
+}
