@@ -0,0 +1,286 @@
+package com.maxrave.soundcloud
+
+import com.maxrave.domain.manager.DataStoreManager
+import com.maxrave.ktorext.encoding.brotliIfSupported
+import com.maxrave.ktorext.getEngine
+import io.ktor.client.HttpClient
+import io.ktor.client.call.body
+import io.ktor.client.plugins.compression.ContentEncoding
+import io.ktor.client.plugins.contentnegotiation.ContentNegotiation
+import io.ktor.client.request.get
+import io.ktor.client.request.parameter
+import io.ktor.client.statement.bodyAsText
+import io.ktor.http.HttpStatusCode
+import io.ktor.http.Url
+import io.ktor.http.contentLength
+import io.ktor.serialization.kotlinx.json.json
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.flow.first
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonElement
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.longOrNull
+
+data class SoundCloudTrack(
+    val id: String,
+    val title: String,
+    val artist: String,
+    val durationMs: Long,
+    val artworkUrl: String?,
+)
+
+/**
+ * SoundCloud's public web client adapter. It does not require a user API key: the web application
+ * publishes a short-lived public client_id in its frontend assets. The resolver caches it and
+ * validates it before exposing the provider to the rest of the app.
+ */
+class SoundCloudClient(
+    private val dataStoreManager: DataStoreManager,
+) {
+    private val json =
+        Json {
+            ignoreUnknownKeys = true
+            explicitNulls = false
+        }
+    private val httpClient =
+        HttpClient(getEngine()) {
+            expectSuccess = false
+            install(ContentNegotiation) { json(json) }
+            install(ContentEncoding) {
+                brotliIfSupported(1.0F)
+                gzip(0.9F)
+                deflate(0.8F)
+            }
+        }
+    private val clientIdResolver = SoundCloudClientIdResolver(httpClient, dataStoreManager)
+
+    suspend fun searchTracks(
+        query: String,
+        limit: Int = 20,
+    ): Result<List<SoundCloudTrack>> =
+        try {
+            val clientId = clientIdResolver.resolve() ?: error("SoundCloud web client ID unavailable")
+            val response =
+                httpClient.get(SEARCH_URL) {
+                    parameter("q", query)
+                    parameter("client_id", clientId)
+                    parameter("limit", limit.coerceIn(1, MAX_RESULTS))
+                    parameter("offset", 0)
+                }
+            if (response.status != HttpStatusCode.OK) error("SoundCloud search HTTP ${response.status.value}")
+            val root = response.body<JsonObject>()
+            Result.success(root["collection"]?.jsonArray.orEmpty().mapNotNull(::parseTrack))
+        } catch (error: Throwable) {
+            Result.failure(error)
+        }
+
+    suspend fun resolveStream(sourceId: String): Result<String?> =
+        try {
+            val clientId = clientIdResolver.resolve() ?: error("SoundCloud web client ID unavailable")
+            val trackId = sourceId.removePrefix(SOUNDCLOUD_ID_PREFIX)
+            val response = httpClient.get("$API_BASE/tracks/$trackId/streams") {
+                parameter("client_id", clientId)
+            }
+            if (response.status != HttpStatusCode.OK) error("SoundCloud stream HTTP ${response.status.value}")
+            val root = response.body<JsonObject>()
+            val legacy =
+                listOf(
+                    root.string("http_mp3_128_url"),
+                    root.string("hls_mp3_128_url"),
+                    root.string("preview_mp3_128_url"),
+                ).filterNotNull()
+            val transcodings =
+                root["media"]
+                    ?.jsonObject
+                    ?.get("transcodings")
+                    ?.jsonArray
+                    .orEmpty()
+                    .mapNotNull { it.jsonObjectOrNull() }
+                    .mapNotNull { transcoding ->
+                        val url = transcoding.string("url") ?: return@mapNotNull null
+                        val protocol = transcoding["format"]?.jsonObjectOrNull()?.string("protocol").orEmpty()
+                        val mime = transcoding["format"]?.jsonObjectOrNull()?.string("mime_type").orEmpty()
+                        val rank = when {
+                            protocol == "progressive" && mime.contains("mpeg", ignoreCase = true) -> 0
+                            protocol == "progressive" -> 1
+                            protocol == "hls" -> 2
+                            else -> 3
+                        }
+                        rank to withClientId(url, clientId)
+                    }
+                    .sortedBy { it.first }
+                    .map { it.second }
+            Result.success((legacy + transcodings).firstOrNull { it.startsWith("http://") || it.startsWith("https://") })
+        } catch (error: Throwable) {
+            Result.failure(error)
+        }
+
+    private fun parseTrack(element: JsonElement): SoundCloudTrack? {
+        val objectValue = element.jsonObjectOrNull() ?: return null
+        val numericId = objectValue["id"]?.jsonPrimitive?.contentOrNull ?: return null
+        val title = objectValue.string("title")?.takeIf { it.isNotBlank() } ?: return null
+        val user = objectValue["user"]?.jsonObjectOrNull()
+        val artist = user?.string("username") ?: "SoundCloud"
+        val artwork =
+            objectValue.string("artwork_url")
+                ?: user?.string("avatar_url")
+        return SoundCloudTrack(
+            id = "$SOUNDCLOUD_ID_PREFIX$numericId",
+            title = title,
+            artist = artist,
+            durationMs = objectValue["duration"]?.jsonPrimitive?.longOrNull ?: 0L,
+            artworkUrl = artwork?.replace("-large", "-t500x500"),
+        )
+    }
+
+    private fun withClientId(url: String, clientId: String): String {
+        val builder = runCatching { io.ktor.http.URLBuilder(url) }.getOrNull() ?: return url
+        if (builder.parameters["client_id"] == null) builder.parameters["client_id"] = clientId
+        return builder.toString()
+    }
+
+    private fun JsonObject.string(key: String): String? = this[key]?.jsonPrimitive?.contentOrNull
+
+    private fun JsonElement.jsonObjectOrNull(): JsonObject? = this as? JsonObject
+
+    companion object {
+        const val SOUNDCLOUD_ID_PREFIX = "sc:"
+        private const val WEB_HOME = "https://soundcloud.com/"
+        private const val API_BASE = "https://api-v2.soundcloud.com"
+        private const val SEARCH_URL = "$API_BASE/search/tracks"
+        private const val MAX_RESULTS = 50
+    }
+}
+
+private class SoundCloudClientIdResolver(
+    private val httpClient: HttpClient,
+    private val dataStoreManager: DataStoreManager,
+) {
+    private val mutex = kotlinx.coroutines.sync.Mutex()
+    private var memoryClientId: String? = null
+    private var memoryFetchedAt = 0L
+
+    suspend fun resolve(): String? = mutex.withLock {
+        val now = kotlin.time.Clock.System.now().toEpochMilliseconds()
+        memoryClientId?.takeIf { now - memoryFetchedAt < CACHE_TTL_MS }?.let { return@withLock it }
+        val cached = dataStoreManager.getString(CACHE_KEY).first()?.split('|')
+        if (cached?.size == 2) {
+            val cachedAt = cached[0].toLongOrNull()
+            val cachedId = cached[1].takeIf(::isValidCandidate)
+            if (cachedAt != null && cachedId != null && now - cachedAt in 0..CACHE_TTL_MS) {
+                memoryClientId = cachedId
+                memoryFetchedAt = cachedAt
+                if (validate(cachedId)) return@withLock cachedId
+            }
+        }
+
+        val homepage = fetchText(WEB_HOME) ?: return@withLock null
+        val assetUrls = extractScriptUrls(homepage).take(MAX_ASSETS)
+        val candidates =
+            buildList {
+                addAll(extractCandidates(homepage))
+                addAll(
+                    coroutineScope {
+                        val semaphore = Semaphore(MAX_CONCURRENT_ASSETS)
+                        assetUrls.map { asset ->
+                            async {
+                                semaphore.withPermit { fetchText(asset)?.let(::extractCandidates).orEmpty() }
+                            }
+                        }.awaitAll().flatten()
+                    },
+                )
+            }.distinct()
+        var valid: String? = null
+        for (candidate in candidates) {
+            if (validate(candidate)) {
+                valid = candidate
+                break
+            }
+        }
+        valid ?: return@withLock null
+        memoryClientId = valid
+        memoryFetchedAt = now
+        dataStoreManager.putString(CACHE_KEY, "$now|$valid")
+        valid
+    }
+
+    private suspend fun validate(clientId: String): Boolean {
+        val response =
+            try {
+                httpClient.get("https://api-v2.soundcloud.com/search/tracks") {
+                    parameter("client_id", clientId)
+                    parameter("q", "test")
+                    parameter("limit", 1)
+                }
+            } catch (_: Throwable) {
+                null
+            }
+        return response?.status == HttpStatusCode.OK
+    }
+
+    private suspend fun fetchText(url: String): String? {
+        val response = try {
+            httpClient.get(url)
+        } catch (_: Throwable) {
+            return null
+        }
+        if (response.status != HttpStatusCode.OK) return null
+        if ((response.contentLength() ?: 0L) > MAX_ASSET_BYTES) return null
+        return response.bodyAsText().take(MAX_ASSET_BYTES)
+    }
+
+    private fun extractScriptUrls(homepage: String): List<String> =
+        SCRIPT_REGEX
+            .findAll(homepage)
+            .mapNotNull { match -> resolveAssetUrl(match.groupValues[1]) }
+            .filter(::isAllowedAsset)
+            .distinct()
+            .toList()
+
+    private fun resolveAssetUrl(raw: String): String? =
+        when {
+            raw.startsWith("https://") || raw.startsWith("http://") -> raw
+            raw.startsWith("//") -> "https:$raw"
+            raw.startsWith("/") -> "https://soundcloud.com$raw"
+            else -> null
+        }
+
+    private fun isAllowedAsset(url: String): Boolean {
+        val host = runCatching { Url(url).host }.getOrNull() ?: return false
+        return host == "soundcloud.com" || host.endsWith(".soundcloud.com") || host.endsWith(".sndcdn.com")
+    }
+
+    private fun extractCandidates(text: String): List<String> =
+        CLIENT_ID_REGEXES
+            .flatMap { regex -> regex.findAll(text).map { it.groupValues[1] }.toList() }
+            .filter(::isValidCandidate)
+            .distinct()
+
+    private fun isValidCandidate(value: String): Boolean =
+        value.length in 20..64 && CLIENT_ID_VALUE_REGEX.matches(value)
+
+    private companion object {
+        const val CACHE_KEY = "soundcloud.web.client_id"
+        const val WEB_HOME = "https://soundcloud.com/"
+        const val CACHE_TTL_MS = 12 * 60 * 60 * 1000L
+        const val MAX_ASSETS = 16
+        const val MAX_CONCURRENT_ASSETS = 4
+        const val MAX_ASSET_BYTES = 2 * 1024 * 1024
+        val SCRIPT_REGEX = Regex("""<script[^>]+src=[\"']([^\"']+\.js[^\"']*)[\"']""", RegexOption.IGNORE_CASE)
+        val CLIENT_ID_REGEXES =
+            listOf(
+                Regex("""(?i)client[_-]?id\s*[=:]\s*[\"']([A-Za-z0-9_-]{20,64})"""),
+                Regex("""(?i)client[_-]?(?:%3[dD]|=)([A-Za-z0-9_-]{20,64})"""),
+            )
+        val CLIENT_ID_VALUE_REGEX = Regex("^[A-Za-z0-9_-]+$")
+    }
+}
