+package com.maxrave.data.mediaservice
+
+import com.maxrave.domain.data.player.GenericMediaItem
+import com.maxrave.domain.data.player.GenericPlaybackParameters
+import com.maxrave.domain.data.player.GenericTracks
+import com.maxrave.domain.data.player.PlayerConstants
+import com.maxrave.domain.data.player.PlayerError
+import com.maxrave.domain.extension.isVideo
+import com.maxrave.domain.manager.DataStoreManager
+import com.maxrave.domain.mediaservice.player.MediaPlayerInterface
+import com.maxrave.domain.mediaservice.player.MediaPlayerListener
+import com.maxrave.domain.repository.StreamRepository
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import platform.AVFoundation.AVPlayer
+import platform.AVFoundation.AVPlayerItem
+import platform.CoreMedia.CMTimeGetSeconds
+import platform.CoreMedia.CMTimeMakeWithSeconds
+import platform.Foundation.NSURL
+import kotlin.math.max
+import kotlin.math.min
+
+private const val IOS_STREAM_TAG = "IosAvPlayerAdapter"
+
+/**
+ * Small AVPlayer-backed implementation of the platform-neutral player contract.
+ *
+ * AVPlayer performs the actual HTTP/HLS work on iOS. The adapter deliberately keeps the queue and
+ * the app's GenericMediaItem values in Kotlin, so the existing Compose view models do not need an
+ * iOS-only media model. A stream repository is used for YouTube/SoundCloud IDs and direct HTTP(S)
+ * URIs remain a fast path for cached or externally supplied media.
+ */
+class IosAvPlayerAdapter(
+    private val streamRepository: StreamRepository,
+    private val dataStoreManager: DataStoreManager,
+    private val coroutineScope: CoroutineScope,
+) : MediaPlayerInterface {
+    private val avPlayer = AVPlayer()
+    private val listeners = mutableListOf<MediaPlayerListener>()
+    private val mediaItems = mutableListOf<GenericMediaItem>()
+    private var currentIndex = -1
+    private var internalPlayWhenReady = false
+    private var internalShuffle = false
+    private var internalRepeatMode = PlayerConstants.REPEAT_MODE_OFF
+    private var internalVolume = 1f
+    private var internalSleepFadeFactor = 1f
+    private var internalPlaybackParameters = GenericPlaybackParameters.DEFAULT
+    private var internalPlaybackState = PlayerConstants.STATE_IDLE
+    private var currentLoadJob: Job? = null
+    private var pollJob: Job? = null
+    private var endHandledForIndex = -1
+    private var released = false
+
+    override var crossfadeSuppressed: Boolean = false
+    override var albumTrackIds: Set<String> = emptySet()
+    override var skipSilenceEnabled: Boolean = false
+
+    init {
+        pollJob = coroutineScope.launch {
+            while (isActive && !released) {
+                publishSnapshot()
+                maybeAdvanceAtEnd()
+                delay(250)
+            }
+        }
+    }
+
+    override fun play() {
+        internalPlayWhenReady = true
+        avPlayer.play()
+        setPlaybackState(PlayerConstants.STATE_READY)
+    }
+
+    override fun pause() {
+        internalPlayWhenReady = false
+        avPlayer.pause()
+    }
+
+    override fun stop() {
+        internalPlayWhenReady = false
+        avPlayer.pause()
+        setPlaybackState(PlayerConstants.STATE_IDLE)
+    }
+
+    override fun seekTo(positionMs: Long) {
+        if (avPlayer.currentItem == null) return
+        avPlayer.seekToTime(CMTimeMakeWithSeconds(max(0L, positionMs).toDouble() / 1000.0, 1000))
+        notifyListeners { it.onSeeked(currentPosition) }
+    }
+
+    override fun seekTo(
+        mediaItemIndex: Int,
+        positionMs: Long,
+    ) {
+        if (mediaItemIndex !in mediaItems.indices) return
+        selectItem(mediaItemIndex, autoPlay = internalPlayWhenReady, reason = PlayerConstants.MEDIA_ITEM_TRANSITION_REASON_SEEK)
+        coroutineScope.launch {
+            delay(50)
+            seekTo(positionMs)
+        }
+    }
+
+    override fun seekBack() = seekTo(max(0L, currentPosition - 10_000L))
+
+    override fun seekForward() = seekTo(currentPosition + 10_000L)
+
+    override fun seekToNext() {
+        nextIndex()?.let { selectItem(it, autoPlay = true, reason = PlayerConstants.MEDIA_ITEM_TRANSITION_REASON_AUTO) }
+    }
+
+    override fun seekToPrevious() {
+        if (currentPosition > 3_000L) {
+            seekTo(0)
+        } else {
+            seekToPreviousMediaItem()
+        }
+    }
+
+    override fun seekToPreviousMediaItem() {
+        previousIndex()?.let { selectItem(it, autoPlay = true, reason = PlayerConstants.MEDIA_ITEM_TRANSITION_REASON_SEEK) }
+    }
+
+    override fun prepare() {
+        if (currentIndex in mediaItems.indices) resolveAndLoad(mediaItems[currentIndex], internalPlayWhenReady)
+    }
+
+    override fun setMediaItem(mediaItem: GenericMediaItem) {
+        mediaItems.clear()
+        mediaItems += mediaItem
+        currentIndex = 0
+        endHandledForIndex = -1
+        notifyTimelineChanged()
+        resolveAndLoad(mediaItem, internalPlayWhenReady)
+    }
+
+    override fun addMediaItem(mediaItem: GenericMediaItem) {
+        mediaItems += mediaItem
+        if (currentIndex < 0) {
+            currentIndex = 0
+            resolveAndLoad(mediaItem, internalPlayWhenReady)
+        }
+        notifyTimelineChanged()
+    }
+
+    override fun addMediaItem(
+        index: Int,
+        mediaItem: GenericMediaItem,
+    ) {
+        mediaItems.add(index.coerceIn(0, mediaItems.size), mediaItem)
+        if (currentIndex < 0) currentIndex = 0
+        else if (index <= currentIndex) currentIndex++
+        notifyTimelineChanged()
+    }
+
+    override fun removeMediaItem(index: Int) {
+        if (index !in mediaItems.indices) return
+        mediaItems.removeAt(index)
+        when {
+            mediaItems.isEmpty() -> {
+                currentIndex = -1
+                avPlayer.replaceCurrentItemWithPlayerItem(null)
+                setPlaybackState(PlayerConstants.STATE_IDLE)
+            }
+            index < currentIndex -> currentIndex--
+            currentIndex >= mediaItems.size -> currentIndex = mediaItems.lastIndex
+        }
+        notifyTimelineChanged()
+    }
+
+    override fun moveMediaItem(
+        fromIndex: Int,
+        toIndex: Int,
+    ) {
+        if (fromIndex !in mediaItems.indices || toIndex !in mediaItems.indices || fromIndex == toIndex) return
+        val item = mediaItems.removeAt(fromIndex)
+        mediaItems.add(toIndex, item)
+        currentIndex = when {
+            currentIndex == fromIndex -> toIndex
+            fromIndex < currentIndex && toIndex >= currentIndex -> currentIndex - 1
+            fromIndex > currentIndex && toIndex <= currentIndex -> currentIndex + 1
+            else -> currentIndex
+        }
+        notifyTimelineChanged()
+    }
+
+    override fun clearMediaItems() {
+        currentLoadJob?.cancel()
+        mediaItems.clear()
+        currentIndex = -1
+        avPlayer.replaceCurrentItemWithPlayerItem(null)
+        setPlaybackState(PlayerConstants.STATE_IDLE)
+        notifyTimelineChanged()
+    }
+
+    override fun replaceMediaItem(
+        index: Int,
+        mediaItem: GenericMediaItem,
+    ) {
+        if (index !in mediaItems.indices) return
+        mediaItems[index] = mediaItem
+        if (index == currentIndex) resolveAndLoad(mediaItem, internalPlayWhenReady)
+        notifyTimelineChanged()
+    }
+
+    override fun getMediaItemAt(index: Int): GenericMediaItem? = mediaItems.getOrNull(index)
+
+    override fun getCurrentMediaTimeLine(): List<GenericMediaItem> = orderedItems()
+
+    override fun getUnshuffledIndex(shuffledIndex: Int): Int = shuffleOrder().getOrNull(shuffledIndex) ?: -1
+
+    override val isPlaying: Boolean
+        get() = avPlayer.rate > 0.0
+
+    override val currentPosition: Long
+        get() = secondsToMillis(avPlayer.currentTime())
+
+    override val duration: Long
+        get() = avPlayer.currentItem?.let { secondsToMillis(it.duration) } ?: 0L
+
+    override val bufferedPosition: Long
+        get() = max(currentPosition, duration.takeIf { it > 0L } ?: 0L)
+
+    override val bufferedPercentage: Int
+        get() = if (duration <= 0L) 0 else ((bufferedPosition * 100L) / duration).toInt().coerceIn(0, 100)
+
+    override val currentMediaItem: GenericMediaItem?
+        get() = mediaItems.getOrNull(currentIndex)
+
+    override val currentMediaItemIndex: Int
+        get() = currentIndex
+
+    override val mediaItemCount: Int
+        get() = mediaItems.size
+
+    override val contentPosition: Long
+        get() = currentPosition
+
+    override val playbackState: Int
+        get() = internalPlaybackState
+
+    override fun hasNextMediaItem(): Boolean = nextIndex() != null
+
+    override fun hasPreviousMediaItem(): Boolean = previousIndex() != null
+
+    override var shuffleModeEnabled: Boolean
+        get() = internalShuffle
+        set(value) {
+            if (internalShuffle == value) return
+            internalShuffle = value
+            notifyListeners { it.onShuffleModeEnabledChanged(value, orderedItems()) }
+            notifyTimelineChanged()
+        }
+
+    override var repeatMode: Int
+        get() = internalRepeatMode
+        set(value) {
+            internalRepeatMode = value.coerceIn(PlayerConstants.REPEAT_MODE_OFF, PlayerConstants.REPEAT_MODE_ALL)
+            notifyListeners { it.onRepeatModeChanged(internalRepeatMode) }
+        }
+
+    override var playWhenReady: Boolean
+        get() = internalPlayWhenReady
+        set(value) {
+            internalPlayWhenReady = value
+            if (value) play() else pause()
+        }
+
+    override var playbackParameters: GenericPlaybackParameters
+        get() = internalPlaybackParameters
+        set(value) {
+            internalPlaybackParameters = value
+            avPlayer.rate = value.speed
+        }
+
+    override val audioSessionId: Int
+        get() = PlayerConstants.AUDIO_SESSION_ID_UNSET
+
+    override var volume: Float
+        get() = internalVolume
+        set(value) {
+            internalVolume = value.coerceIn(0f, 1f)
+            applyVolume()
+            notifyListeners { it.onVolumeChanged(internalVolume) }
+        }
+
+    override var sleepFadeFactor: Float
+        get() = internalSleepFadeFactor
+        set(value) {
+            internalSleepFadeFactor = value.coerceIn(0f, 1f)
+            applyVolume()
+        }
+
+    override fun addListener(listener: MediaPlayerListener) {
+        if (!listeners.contains(listener)) listeners += listener
+    }
+
+    override fun removeListener(listener: MediaPlayerListener) {
+        listeners -= listener
+    }
+
+    override fun release() {
+        if (released) return
+        released = true
+        currentLoadJob?.cancel()
+        pollJob?.cancel()
+        listeners.clear()
+        avPlayer.pause()
+        avPlayer.replaceCurrentItemWithPlayerItem(null)
+    }
+
+    private fun resolveAndLoad(
+        mediaItem: GenericMediaItem,
+        autoPlay: Boolean,
+    ) {
+        currentLoadJob?.cancel()
+        setPlaybackState(PlayerConstants.STATE_BUFFERING)
+        currentLoadJob = coroutineScope.launch {
+            val uri = mediaItem.uri?.takeIf { it.startsWith("http://") || it.startsWith("https://") }
+                ?: runCatching {
+                    streamRepository
+                        .getStream(dataStoreManager, mediaItem.mediaId, false, mediaItem.isVideo(), false)
+                        .first()
+                }.getOrNull()
+            if (uri.isNullOrBlank()) {
+                setPlaybackState(PlayerConstants.STATE_IDLE)
+                notifyListeners {
+                    it.onPlayerError(PlayerError(0, IOS_STREAM_TAG, "Không tìm thấy luồng phát cho ${mediaItem.metadata.title ?: mediaItem.mediaId}"))
+                }
+                return@launch
+            }
+            val url = NSURL(string = uri) ?: return@launch
+            avPlayer.replaceCurrentItemWithPlayerItem(AVPlayerItem(uRL = url))
+            applyVolume()
+            avPlayer.rate = if (autoPlay) internalPlaybackParameters.speed else 0.0
+            setPlaybackState(PlayerConstants.STATE_READY)
+            notifyListeners { it.onMediaItemTransition(mediaItem, PlayerConstants.MEDIA_ITEM_TRANSITION_REASON_PLAYLIST_CHANGED) }
+        }
+    }
+
+    private fun selectItem(
+        index: Int,
+        autoPlay: Boolean,
+        reason: Int,
+    ) {
+        if (index !in mediaItems.indices) return
+        currentIndex = index
+        endHandledForIndex = -1
+        resolveAndLoad(mediaItems[index], autoPlay)
+        notifyListeners { it.onMediaItemTransition(mediaItems[index], reason) }
+    }
+
+    private fun nextIndex(): Int? {
+        if (mediaItems.isEmpty() || currentIndex < 0) return null
+        val order = shuffleOrder()
+        val orderIndex = order.indexOf(currentIndex)
+        return when {
+            orderIndex >= 0 && orderIndex < order.lastIndex -> order[orderIndex + 1]
+            internalRepeatMode == PlayerConstants.REPEAT_MODE_ALL -> order.firstOrNull()
+            else -> null
+        }
+    }
+
+    private fun previousIndex(): Int? {
+        if (mediaItems.isEmpty() || currentIndex < 0) return null
+        val order = shuffleOrder()
+        val orderIndex = order.indexOf(currentIndex)
+        return when {
+            orderIndex > 0 -> order[orderIndex - 1]
+            internalRepeatMode == PlayerConstants.REPEAT_MODE_ALL -> order.lastOrNull()
+            else -> null
+        }
+    }
+
+    private fun shuffleOrder(): List<Int> {
+        if (!internalShuffle) return mediaItems.indices.toList()
+        val before = mediaItems.indices.filter { it != currentIndex }
+        return listOfNotNull(currentIndex.takeIf { it in mediaItems.indices }) + before
+    }
+
+    private fun orderedItems(): List<GenericMediaItem> = shuffleOrder().mapNotNull { mediaItems.getOrNull(it) }
+
+    private fun maybeAdvanceAtEnd() {
+        val currentDuration = duration
+        if (!internalPlayWhenReady || currentDuration <= 0L || currentIndex == endHandledForIndex) return
+        if (!isPlaying && currentPosition >= currentDuration - 500L) {
+            endHandledForIndex = currentIndex
+            if (internalRepeatMode == PlayerConstants.REPEAT_MODE_ONE) {
+                selectItem(currentIndex, autoPlay = true, reason = PlayerConstants.MEDIA_ITEM_TRANSITION_REASON_REPEAT)
+            } else {
+                nextIndex()?.let {
+                    selectItem(it, autoPlay = true, reason = PlayerConstants.MEDIA_ITEM_TRANSITION_REASON_AUTO)
+                } ?: run {
+                    internalPlayWhenReady = false
+                    setPlaybackState(PlayerConstants.STATE_ENDED)
+                }
+            }
+        }
+    }
+
+    private fun publishSnapshot() {
+        if (released) return
+        val state = if (isPlaying) PlayerConstants.STATE_READY else internalPlaybackState
+        if (state != internalPlaybackState && state != PlayerConstants.STATE_BUFFERING) setPlaybackState(state)
+        notifyListeners { it.onIsPlayingChanged(isPlaying) }
+    }
+
+    private fun setPlaybackState(state: Int) {
+        if (internalPlaybackState == state) return
+        internalPlaybackState = state
+        notifyListeners { it.onPlaybackStateChanged(state) }
+    }
+
+    private fun notifyTimelineChanged() {
+        val timeline = orderedItems()
+        notifyListeners { it.onTimelineChanged(timeline, "TIMELINE_CHANGE_REASON_PLAYLIST_CHANGED") }
+    }
+
+    private inline fun notifyListeners(action: (MediaPlayerListener) -> Unit) {
+        listeners.toList().forEach(action)
+    }
+
+    private fun applyVolume() {
+        avPlayer.volume = (internalVolume * internalSleepFadeFactor).coerceIn(0f, 1f)
+    }
+
+    private fun secondsToMillis(time: platform.CoreMedia.CMTime): Long {
+        val seconds = CMTimeGetSeconds(time)
+        return if (seconds.isFinite() && seconds > 0.0) (seconds * 1000.0).toLong() else 0L
+    }
+}
